                <div class="flex gap-2 mb-2">
                    <input type="email" id="newEmailInput" placeholder="ایمیل جدید..." class="w-full bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-brand-500">
                    <button onclick="addNewEmail()" class="btn-neon px-4 py-2 rounded-lg text-xs font-bold whitespace-nowrap">افزودن</button>
                </div>
                <div id="emailGallery" class="flex flex-col gap-2"></div>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- MODAL درخواست پروژه جدید (جدید) -->
    <!-- ========================================== -->
    <div id="projectModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-6 relative">
            <button onclick="closeProjectRequest()" class="absolute top-4 left-4 text-gray-400 hover:text-gray-600 transition-colors">
                <i class="ri-close-line text-2xl"></i>
            </button>
            <div class="text-center">
                <h3 class="text-2xl font-black text-gray-800">ثبت درخواست پروژه</h3>
                <p class="text-sm text-gray-500 mt-2">درخواست پروژه یا در روبیکا یا در اینستاگرام</p>
            </div>
            
            <div class="flex flex-col gap-4 pt-2">
                <a href="https://www.instagram.com/artinpla?igsh=eW1mamJscGpnNzhs" target="_blank" onclick="showToast('درخواست شما به اینستاگرام ارسال شد!')" class="flex items-center justify-center gap-3 px-6 py-4 bg-gray-900 text-white rounded-xl font-bold transition-transform hover:-translate-y-1 hover:shadow-lg border border-gray-800 w-full">
                    <i class="ri-instagram-line text-xl text-brand-500"></i>
                    <span>ثبت درخواست در اینستاگرام</span>
                </a>
                
                <a href="https://rubika.ir/artin_pla" target="_blank" onclick="showToast('درخواست شما به روبیکا ارسال شد!')" class="flex items-center justify-center gap-3 px-6 py-4 btn-neon rounded-xl font-bold w-full">
                    <i class="ri-message-2-line text-xl"></i>
                    <span>ثبت درخواست در روبیکا</span>
                </a>
                
                <p class="text-[10px] text-gray-400 text-center mt-2">* پس از ارسال درخواست، در سریع‌ترین زمان با شما تماس گرفته می‌شود.</p>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- کانتینر پیام (Toast) -->
    <!-- ========================================== -->
    <div id="toast-container"></div>

    <!-- Swiper Script -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
    
    <script>
        // ==========================================
        // 1. تنظیمات اسلایدر
        // ==========================================
        new Swiper('.hero-swiper', {
            loop: true, autoplay: { delay: 5000, disableOnInteraction: false },
            pagination: { el: '.swiper-pagination', clickable: true },
            navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
        });

        // ==========================================
        // 2. سیستم ورود (Login & Logout)
        // ==========================================
        let selectedProfilePic = null;
        function openLoginModal() { document.getElementById('loginModal').classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
        function closeLoginModal() { document.getElementById('loginModal').classList.add('hidden'); document.body.style.overflow = ''; }
        function handleProfilePicUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) { selectedProfilePic = e.target.result; document.getElementById('profilePicPreview').src = selectedProfilePic; };
                reader.readAsDataURL(file);
            }
        }
        function login() {
            const email = document.getElementById('email').value;
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            if (!email || !username || !password) return alert('لطفاً تمام فیلدها را پر کنید!');
            if (!selectedProfilePic) selectedProfilePic = document.getElementById('profilePicPreview').src;
            
            localStorage.setItem('pla_user_email', email);
            localStorage.setItem('pla_username', username);
            localStorage.setItem('pla_profile_pic', selectedProfilePic);
            if (!localStorage.getItem('pla_emails')) localStorage.setItem('pla_emails', JSON.stringify([]));

            closeLoginModal();
            updateUIBasedOnLogin();
            alert(`خوش آمدید ${username}!`);
        }
        function updateUIBasedOnLogin() {
            const savedUsername = localStorage.getItem('pla_username');
            const savedProfilePic = localStorage.getItem('pla_profile_pic');
            if (savedUsername) {
                document.getElementById('loginActions').classList.add('hidden');
                document.getElementById('loggedInActions').classList.remove('hidden');
                document.getElementById('loggedInUsername').textContent = savedUsername;
                document.getElementById('userProfileImg').src = savedProfilePic || 'https://ui-avatars.com/api/?name=User&background=random&size=128';
            }
        }
        function logout() {
            localStorage.removeItem('pla_user_email'); localStorage.removeItem('pla_username'); localStorage.removeItem('pla_profile_pic'); localStorage.removeItem('pla_emails');
            document.getElementById('loggedInActions').classList.add('hidden');
            document.getElementById('loginActions').classList.remove('hidden');
            document.getElementById('email').value = ''; document.getElementById('username').value = ''; document.getElementById('password').value = '';
            selectedProfilePic = null; document.getElementById('profilePicPreview').src = 'https://ui-avatars.com/api/?name=User&background=random&size=128';
            closeProfileModal();
        }
        window.onload = function() { updateUIBasedOnLogin(); };
        document.getElementById('loginModal').addEventListener('click', function(e) { if (e.target === this) closeLoginModal(); });

        // ==========================================
        // 3. سیستم جستجوی هوشمند
        // ==========================================
        const siteData = [
            { title: 'طراحی سایت هنری', url: '#works' }, { title: 'طراحی سایت شرکتی', url: '#works' },
            { title: 'هویت بصری و لوگو', url: '#works' }, { title: 'تایپوگرافی و پوستر', url: '#works' },
            { title: 'سئو و بهینه‌سازی', url: '#works' }, { title: 'درباره ARTIN PLA', url: '#about' },
            { title: 'ارتباط با ما (تماس)', url: '#contact' }, { title: 'اینستاگرام', url: 'https://www.instagram.com/artinpla' },
            { title: 'روبیکا', url: 'https://rubika.ir/artin_pla' }
        ];
        const searchInput = document.getElementById('searchInput');
        const searchDropdown = document.getElementById('searchDropdown');
        searchInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            searchDropdown.innerHTML = '';
            if (query.length === 0) { searchDropdown.classList.add('hidden'); return; }
            const results = siteData.filter(item => item.title.toLowerCase().includes(query));
            if (results.length > 0) {
                searchDropdown.classList.remove('hidden');
                results.forEach(item => {
                    const div = document.createElement('div');
                    div.className = 'flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-brand-500 hover:text-white cursor-pointer transition-all text-sm text-gray-700';
                    const isExternal = item.url.startsWith('http');
                    div.innerHTML = `<i class="ri-search-line text-brand-500 group-hover:text-white"></i><span>${item.title}</span>`;
                    div.addEventListener('click', function() {
                        searchDropdown.classList.add('hidden'); searchInput.value = '';
                        if (isExternal) window.open(item.url, '_blank');
                        else { const target = document.querySelector(item.url); if (target) target.scrollIntoView({ behavior: 'smooth' }); }
                    });
                    searchDropdown.appendChild(div);
                });
            } else {
                searchDropdown.classList.remove('hidden');
                const div = document.createElement('div');
                div.className = 'px-3 py-4 text-center text-xs text-gray-500 flex flex-col gap-2';
                div.innerHTML = `<i class="ri-error-warning-line text-2xl text-brand-500"></i><span>نتیجه‌ای برای "<strong>${query}</strong>" یافت نشد.</span><span class="text-[10px] text-gray-400">لطفاً درباره سایت (طراحی، برندینگ، تماس) جستجو کنید.</span>`;
                searchDropdown.appendChild(div);
            }
        });
        document.addEventListener('click', function(e) {
            if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) searchDropdown.classList.add('hidden');
        });

        // ==========================================
        // 4. مودال پروفایل و کارت 3D
        // ==========================================
        function openProfileModal() {
            const username = localStorage.getItem('pla_username');
            const email = localStorage.getItem('pla_user_email');
            const pic = localStorage.getItem('pla_profile_pic');
            let hash = 0; for (let i = 0; i < username.length; i++) hash = username.charCodeAt(i) + ((hash << 5) - hash);
            const lastFour = String(Math.abs(hash)).slice(0, 4).padStart(4, '0');
            document.getElementById('profileCardName').textContent = username;
            document.getElementById('profileCardEmail').textContent = email;
            document.getElementById('profileCardImg').src = pic;
            document.getElementById('cardNumber').textContent = `****-****-****-${lastFour}`;
            renderEmailGallery();
            document.getElementById('profileModal').classList.remove('hidden'); document.body.style.overflow = 'hidden';
            document.getElementById('cardInner').classList.remove('is-flipped');
        }
        function closeProfileModal() { document.getElementById('profileModal').classList.add('hidden'); document.body.style.overflow = ''; }
        function flipCard() { document.getElementById('cardInner').classList.toggle('is-flipped'); }
        function saveProfile() { document.getElementById('cardInner').classList.remove('is-flipped'); }
        function deleteAccount() {
            if (confirm('آیا از حذف حساب کاربری خود مطمئن هستید؟')) { logout(); alert('حساب کاربری شما حذف شد.'); }
        }
        const card = document.getElementById('profileCard');
        if (card) {
            card.addEventListener('mousemove', function(e) {
                const rect = this.getBoundingClientRect();
                const x = e.clientX - rect.left; const y = e.clientY - rect.top;
                const centerX = rect.width / 2; const centerY = rect.height / 2;
                this.style.transform = `rotateX(${(y - centerY) / centerY * -8}deg) rotateY(${(x - centerX) / centerX * 8}deg)`;
            });
            card.addEventListener('mouseleave', function() { this.style.transform = 'rotateX(0deg) rotateY(0deg)'; });
        }
        document.getElementById('profileModal').addEventListener('click', function(e) { if (e.target === this) closeProfileModal(); });

        // ==========================================
        // 5. گالری ایمیل‌ها
        // ==========================================
        function getEmails() { const emails = localStorage.getItem('pla_emails'); return emails ? JSON.parse(emails) : []; }
        function renderEmailGallery() {
            const container = document.getElementById('emailGallery');
            const emails = getEmails(); container.innerHTML = '';
            if (emails.length === 0) { container.innerHTML = '<p class="text-xs text-gray-400 text-center py-2">هیچ ایمیل اضافی ثبت نشده است.</p>'; return; }
            emails.forEach((email, index) => {
                const div = document.createElement('div');
                div.className = 'flex items-center justify-between bg-gray-50 px-3 py-2 rounded-lg border border-gray-200';
                div.innerHTML = `<span class="text-sm text-gray-700">${email}</span><button onclick="deleteEmail(${index})" class="text-xs text-red-400 hover:text-red-600 transition-colors"><i class="ri-delete-bin-line text-lg"></i></button>`;
                container.appendChild(div);
            });
        }
        function addNewEmail() {
            const input = document.getElementById('newEmailInput');
            const email = input.value.trim();
            if (!email) return alert('لطفاً یک ایمیل معتبر وارد کنید!');
            const emails = getEmails();
            if (emails.includes(email)) return alert('این ایمیل قبلاً ثبت شده است!');
            emails.push(email); localStorage.setItem('pla_emails', JSON.stringify(emails));
            input.value = ''; renderEmailGallery();
        }
        function deleteEmail(index) { const emails = getEmails(); emails.splice(index, 1); localStorage.setItem('pla_emails', JSON.stringify(emails)); renderEmailGallery(); }

        // ==========================================
        // 6. سیستم درخواست پروژه جدید و پیام (Toast)
        // ==========================================
        function openProjectRequest() {
            document.getElementById('projectModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }
        function closeProjectRequest() {
            document.getElementById('projectModal').classList.add('hidden');
            document.body.style.overflow = '';
        }
        document.getElementById('projectModal').addEventListener('click', function(e) {
            if (e.target === this) closeProjectRequest();
        });

        // تابع نمایش پیام نئونی (Toast)
        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast-item show';
            toast.innerHTML = `
                <i class="ri-check-line text-brand-500 text-xl"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);

            // حذف پیام بعد از 3 ثانیه
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 400);
            }, 3000);
        }
    </script>
</body>
</html>
