<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARTIN PLA | طراحی وب‌سایت حرفه‌ای، مدرن و هنری</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font: Vazirmatn -->
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
    
    <!-- Icons: Remix Icon -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">

    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Vazirmatn', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#76FF03', 600: '#4c9a00', 700: '#3a7700', 900: '#1f4300' },
                        accent: { 500: '#f43f5e' }
                    }
                }
            }
        }
    </script>

    <style>
        body { background-color: #f8fafc; }
        
        /* استایل عکس پروفایل کاربر */
        .profile-pic-upload-container {
            position: relative; width: 80px; height: 80px; margin: 0 auto;
            border-radius: 50%; overflow: hidden; background-color: #e5e7eb;
            border: 2px dashed #d1d5db; cursor: pointer; transition: all 0.3s ease;
        }
        .profile-pic-upload-container:hover { border-color: #76FF03; }
        .profile-pic-upload-container img { width: 100%; height: 100%; object-fit: cover; }
        .profile-pic-upload-container input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }

        /* ===============================
           افکت طناب نوری (Light Rope)
           =============================== */
        .light-rope-wrapper { position: relative; display: inline-block; }
        .light-rope-svg {
            position: absolute; bottom: -2px; left: 0;
            width: 100%; height: 4px; pointer-events: none; overflow: visible;
        }
        .light-rope-path {
            fill: none; stroke: #76FF03; stroke-width: 2; stroke-linecap: round;
            transition: stroke-dashoffset 0.1s linear;
            stroke-dasharray: 1000; stroke-dashoffset: 1000;
            filter: drop-shadow(0 0 6px #76FF03);
        }
        .light-rope-wrapper:hover .light-rope-path {
            stroke-dashoffset: 0;
            transition: stroke-dashoffset 0.8s cubic-bezier(0.2, 0.9, 0.3, 1.1);
        }
        
        /* ===============================
           استایل دکمه نئونی
           =============================== */
        .btn-neon {
            background-color: #76FF03; color: #0b0907;
            box-shadow: 0 4px 14px rgba(118, 255, 3, 0.3);
            transition: all 0.3s ease;
        }
        .btn-neon:hover {
            background-color: #66dd03; box-shadow: 0 8px 24px rgba(118, 255, 3, 0.5);
            transform: translateY(-2px);
        }

        /* استایل دراپ‌داون جستجو */
        #searchDropdown {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            width: 100%;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            border: 1px solid #f0f0f0;
            z-index: 50;
            max-height: 250px;
            overflow-y: auto;
        }
        #searchDropdown::-webkit-scrollbar { width: 6px; }
        #searchDropdown::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 4px; }

        /* ===============================
           استایل کارت 3D (Tilt Card) - بانکی
           =============================== */
        .card-slot {
            perspective: 800px;
            margin: 0 auto;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .card {
            width: 100%;
            max-width: 380px;
            height: 240px;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.1s ease-out;
            cursor: default;
        }
        .card.tilt { transition: transform 0.1s ease-out; }
        .glow.glow-ok {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            height: 100%;
            pointer-events: none;
            border-radius: 20px;
            box-shadow: 0 0 26px 4px #76FF03, 0 0 62px 18px rgba(118, 255, 3, 0.4);
            opacity: 0.5;
            transition: opacity 0.3s ease;
            z-index: 0;
        }
        .card_inner {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform 0.6s cubic-bezier(0.4, 0.0, 0.2, 1);
            transform-style: preserve-3d;
        }
        .card_inner.is-flipped { transform: rotateY(180deg); }
        .card_face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 20px;
            overflow: hidden;
            background: #0f172a;
            border: 1px solid #1e293b;
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
        }
        .card_face-front {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            padding: 24px 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: white;
        }
        .card_face-back {
            transform: rotateY(180deg);
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            padding: 24px 20px;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card-brand {
            font-size: 1.6rem; font-weight: 900; letter-spacing: 0.05em; color: #ffffff;
            text-shadow: 0 0 15px rgba(118, 255, 3, 0.4); margin-bottom: 4px;
        }
        .card-brand-sub { font-size: 0.55rem; color: #76FF03; letter-spacing: 0.2em; margin-top: -6px; margin-bottom: 10px; }
        .card-number-wrapper { display: flex; justify-content: center; align-items: center; margin: 8px 0; }
        .card-number { font-family: 'Courier New', monospace; font-size: 1.4rem; font-weight: 600; letter-spacing: 3px; color: #e2e8f0; text-shadow: 0 0 10px rgba(255,255,255,0.1); }
        .card-holder-section { display: flex; align-items: center; gap: 14px; margin-top: 8px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 12px; }
        .card-avatar { width: 48px; height: 48px; border-radius: 50%; border: 2px solid #76FF03; object-fit: cover; box-shadow: 0 0 15px rgba(118, 255, 3, 0.2); }
        .card-holder-details { flex: 1; display: flex; flex-direction: column; }
        .card-holder-name { font-size: 1rem; font-weight: 700; color: #f1f5f9; }
        .card-holder-tag { font-size: 0.6rem; color: #64748b; letter-spacing: 0.1em; text-transform: uppercase; }
        .card-chip { width: 42px; height: 32px; background: linear-gradient(135deg, #fbbf24, #f59e0b); border-radius: 6px; align-self: flex-end; margin-top: -10px; }

        .card-back-title { font-size: 0.7rem; color: #94a3b8; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 4px; }
        .card-back-email { font-size: 1.1rem; font-weight: 600; color: #e2e8f0; word-break: break-all; }
        .card-magnetic { height: 40px; background: #1e293b; margin: 12px 0; border-radius: 4px; border: 1px solid #334155; }

        /* ===============================
           استایل پیام (Toast)
           =============================== */
        #toast-container {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            pointer-events: none;
            transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.1);
        }
        .toast-item {
            pointer-events: auto;
            background-color: #0f172a;
            border: 1px solid #76FF03;
            color: #ffffff;
            padding: 14px 24px;
            border-radius: 16px;
            box-shadow: 0 0 30px rgba(118, 255, 3, 0.3);
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.95rem;
            font-weight: 500;
            transform: translateY(20px);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.1);
        }
        .toast-item.show {
            transform: translateY(0);
            opacity: 1;
        }
    </style>
</head>
<body class="font-sans text-gray-800 antialiased selection:bg-brand-500 selection:text-white">

    <!-- TOP BAR -->
    <div class="bg-brand-900 text-white text-xs py-2 px-4 text-center hidden md:block">
        <span>🚀 مشاوره رایگان طراحی سایت برای برندهای مدرن | همین حالا از طریق اینستاگرام یا روبیکا پیام دهید</span>
    </div>

    <!-- HEADER SECTION -->
    <header class="sticky top-0 z-50 bg-white shadow-sm transition-all duration-300" id="main-header">
        <div class="container mx-auto px-4 py-4 flex flex-col md:flex-row items-center gap-4 justify-between relative">
            
            <!-- ردیف اول: لوگو، جستجو و دکمه‌های کاربر -->
            <div class="flex flex-col md:flex-row w-full items-center justify-between gap-4">
                
                <!-- Logo -->
                <div class="flex items-center w-full md:w-auto justify-between md:justify-start gap-4">
                    <button class="md:hidden text-2xl text-gray-600"><i class="ri-menu-line"></i></button>
                    <a href="#" class="flex items-center gap-3">
                        <div class="w-12 h-12 bg-black rounded-xl overflow-hidden flex items-center justify-center border-2 border-brand-500">
                            <img src="https://i.postimg.cc/6qBX47HK/IMG-20260807-101050-346.jpg" alt="ARTIN PLA Logo" class="w-full h-full object-cover">
                        </div>
                        <div>
                            <h1 class="text-xl font-black text-gray-900 tracking-tighter leading-none">ARTIN PLA</h1>
                            <p class="text-[10px] text-brand-600 font-bold">طراحی وب‌سایت · مدرن و هنری</p>
                        </div>
                    </a>
                </div>

                <!-- Search Bar -->
                <div class="light-rope-wrapper w-full md:flex-1 max-w-2xl relative group hidden md:block">
                    <div class="relative">
                        <input type="text" id="searchInput" placeholder="جستجو در خدمات..." 
                            class="w-full bg-gray-100 border border-transparent focus:border-brand-500 focus:bg-white rounded-xl py-3 pr-12 pl-4 transition-all outline-none text-sm text-gray-700 autocomplete-off">
                        <i class="ri-search-line absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-brand-600"></i>
