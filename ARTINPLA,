                <!-- Actions -->
                <div class="hidden md:flex items-center gap-3 relative">
                    <div id="loginActions">
                        <button onclick="openLoginModal()" class="flex items-center gap-2 px-5 py-2.5 border border-gray-200 rounded-xl hover:bg-gray-50 transition-colors text-sm font-medium text-gray-700 group">
                            <i class="ri-user-line text-lg group-hover:text-brand-600 transition-colors"></i>
                            <span>ورود</span>
                        </button>
                    </div>
                    
                    <div id="loggedInActions" class="hidden flex items-center gap-3 bg-gray-100 rounded-xl px-3 py-1.5 border border-gray-200 cursor-pointer" onclick="openProfileModal()">
