                            <img id="userProfileImg" src="" alt="Profile" class="w-full h-full object-cover">
                        </div>
                        <span id="loggedInUsername" class="text-sm font-bold text-gray-700"></span>
                        <button onclick="event.stopPropagation(); logout()" class="text-xs text-gray-500 hover:text-red-500 transition-colors">
                            <i class="ri-logout-box-r-line text-lg"></i>
                        </button>
                    </div>

                    <!-- دکمه پروژه جدید (تغییر یافته) -->
                    <button onclick="openProjectRequest()" class="btn-neon flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-medium">
                        <i class="ri-file-list-3-line text-lg"></i>
                        <span>پروژه جدید</span>
                    </button>
                </div>
            </div>

            <!-- پنل دسترسی سریع -->
            <div class="hidden md:flex items-center gap-2 w-full justify-end mt-2 px-1">
                <span class="text-[10px] text-gray-400 ml-2">دسترسی سریع:</span>
                <a href="#about" class="text-[10px] bg-gray-100 hover:bg-brand-500 hover:text-white transition-colors px-3 py-1 rounded-full text-gray-600 font-medium">درباره ما</a>
                <a href="#works" class="text-[10px] bg-gray-100 hover:bg-brand-500 hover:text-white transition-colors px-3 py-1 rounded-full text-gray-600 font-medium">نمونه‌کارها</a>
                <a href="#contact" class="text-[10px] bg-gray-100 hover:bg-brand-500 hover:text-white transition-colors px-3 py-1 rounded-full text-gray-600 font-medium">تماس با ما</a>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="container mx-auto px-4 py-6 space-y-8">

        <!-- HERO SLIDER -->
        <section id="works" class="rounded-2xl overflow-hidden shadow-soft relative group h-[300px] md:h-[450px] scroll-mt-32">
            <div class="swiper hero-swiper h-full w-full">
                <div class="swiper-wrapper">
